{
  "skyrimnet_knowledge_pack": {
    "format_version": 3,
    "name": "Adventurers Guild",
    "description": "Lore of the Adventurers Guild in Tamriel and Skyrim, known to each NPC according to who they are.",
    "version": "1.16.2",
    "entries": [
      {
        "key": "ag_basics",
        "display_name": "The Adventurers Guild",
        "content": "The Adventurers Guild is an Emperor-chartered guild of freelance adventurers: monster-slayers, treasure-hunters, sellswords with a conscience. Anyone with the nerve can join, whatever their birth, and rise by their deeds from E-rank to the legendary S-rank. Its home in Skyrim is the Guild Hall on the road next to Riverwood, the one hall the Guild keeps in the province, where its Guild Master keeps the Guild's records and its members eat, train and sleep between jobs. Every hold capital's inn keeps a Guild counter too, where the innkeeper buys the trophies of a good hunt, pays out the Guild's reports and hands out its work. It is spoken of with respect and a little wonder, and always as the Adventurers Guild, never just \"the Guild\", which could mean the Thieves Guild.",
        "condition_expr": "get_global_value(\"AG_GuildHallInstalledGlobal\") == 1",
        "always_inject": false,
        "importance": 0.8,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_basics_nohall",
        "display_name": "The Adventurers Guild",
        "content": "The Adventurers Guild is an Emperor-chartered guild of freelance adventurers: monster-slayers, treasure-hunters, sellswords with a conscience. Anyone with the nerve can join, whatever their birth, and rise by their deeds from E-rank to the legendary S-rank. In Skyrim it keeps no hall of its own: its counters stand in the inns of the hold capitals, where the innkeeper buys the trophies of a good hunt, pays out the Guild's reports and hands out its work. It is spoken of with respect and a little wonder, and always as the Adventurers Guild, never just \"the Guild\", which could mean the Thieves Guild.",
        "condition_expr": "get_global_value(\"AG_GuildHallInstalledGlobal\") == 0",
        "always_inject": false,
        "importance": 0.8,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_reputation",
        "display_name": "How folk see Guild adventurers",
        "content": "Most folk are glad to see an Adventurers Guild adventurer. They clear the bandits off the roads, the trolls off the passes and the draugr out of the barrows when the Jarl's guards cannot, and a ranked adventurer rarely pays for their own drink in a grateful town. Bards sing of the great ranks, children play at being S-rank heroes, and a high rank letter turns heads.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.8,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers",
          "reputation"
        ]
      },
      {
        "key": "ag_counters",
        "display_name": "Where the Guild keeps its counters",
        "content": "The Adventurers Guild keeps a counter at the inn of every hold capital, kept by the innkeeper: the Bannered Mare in Whiterun (Hulda), the Winking Skeever in Solitude (Corpulus Vinius), Candlehearth Hall in Windhelm (Elda Early-Dawn), the Bee and Barb in Riften (Keerava), the Silver-Blood Inn in Markarth (Kleppr), the Dead Man's Drink in Falkreath (Valga Vinicia), Moorside Inn in Morthal (Jonna), Windpeak Inn in Dawnstar (Thoring) and the Frozen Hearth in Winterhold (Dagur). Smaller inns have no counter and send adventurers to the nearest capital. Across the water, the Retching Netch in Raven Rock (Geldis Sadri) keeps the one counter on Solstheim. And the Guild Hall next to Riverwood keeps a counter of its own, kept by its two clerks, Margot Belleau by day and Nessa in the evening: the one counter that hands out every hold's work.",
        "condition_expr": "get_global_value(\"AG_GuildHallInstalledGlobal\") == 1",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "inns",
          "counters"
        ]
      },
      {
        "key": "ag_counters_nohall",
        "display_name": "Where the Guild keeps its counters",
        "content": "The Adventurers Guild keeps a counter at the inn of every hold capital, kept by the innkeeper: the Bannered Mare in Whiterun (Hulda), the Winking Skeever in Solitude (Corpulus Vinius), Candlehearth Hall in Windhelm (Elda Early-Dawn), the Bee and Barb in Riften (Keerava), the Silver-Blood Inn in Markarth (Kleppr), the Dead Man's Drink in Falkreath (Valga Vinicia), Moorside Inn in Morthal (Jonna), Windpeak Inn in Dawnstar (Thoring) and the Frozen Hearth in Winterhold (Dagur). Smaller inns have no counter and send adventurers to the nearest capital. Across the water, the Retching Netch in Raven Rock (Geldis Sadri) keeps the one counter on Solstheim.",
        "condition_expr": "get_global_value(\"AG_GuildHallInstalledGlobal\") == 0",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "inns",
          "counters"
        ]
      },
      {
        "key": "ag_where_registration_hall",
        "display_name": "Joining the Adventurers Guild",
        "content": "Newcomers join the Adventurers Guild only at the Guild Hall next to Riverwood, where its clerks register them for a fee. The innkeepers who keep the Guild's counters no longer sign anyone up: they send a would-be adventurer to the hall. A member's followers are registered there too, each for the same fee.",
        "condition_expr": "get_global_value(\"AG_HallRegistrationGlobal\") == 1",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_where_registration_inns",
        "display_name": "Joining the Adventurers Guild",
        "content": "Newcomers join the Adventurers Guild at any Guild counter, for a fee: at the Guild Hall next to Riverwood, or at the inn counter of a hold capital. A member's followers can be registered at any counter too, each for the same fee.",
        "condition_expr": "get_global_value(\"AG_HallRegistrationGlobal\") == 0",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_where_promotion_hall",
        "display_name": "Guild promotions",
        "content": "Cases for promotion are heard only at the Guild Hall next to Riverwood, by its clerks. An innkeeper who keeps a Guild counter sends an adventurer who is due a promotion to the hall.",
        "condition_expr": "get_global_value(\"AG_HallPromotionGlobal\") == 1",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_where_promotion_inns",
        "display_name": "Guild promotions",
        "content": "Any Guild counter hears a case for promotion: the clerks at the Guild Hall next to Riverwood, or an innkeeper who keeps a hold's counter.",
        "condition_expr": "get_global_value(\"AG_HallPromotionGlobal\") == 0",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_where_training_hall",
        "display_name": "Where the Guild trains",
        "content": "The Guild's training, Appraisal and the drills and perk training alike, is given only at the Guild Hall next to Riverwood.",
        "condition_expr": "get_global_value(\"AG_HallTrainingGlobal\") == 1",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_where_training_inns",
        "display_name": "Where the Guild trains",
        "content": "The Guild's training, Appraisal and the drills and perk training alike, is given at every Guild counter: the inns' as well as the Guild Hall next to Riverwood's.",
        "condition_expr": "get_global_value(\"AG_HallTrainingGlobal\") == 0",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_where_boxes_hall",
        "display_name": "Where Guild Boxes are sold",
        "content": "Guild Boxes are sold only at the Guild Hall next to Riverwood, from the Guild's vaults.",
        "condition_expr": "get_global_value(\"AG_HallBoxesGlobal\") == 1",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_where_boxes_inns",
        "display_name": "Where Guild Boxes are sold",
        "content": "Guild Boxes are sold at every Guild counter, the inns' as well as the Guild Hall next to Riverwood's.",
        "condition_expr": "get_global_value(\"AG_HallBoxesGlobal\") == 0",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_where_library_hall",
        "display_name": "The Guild Library",
        "content": "The Guild Library's skill books are sold only at the Guild Hall next to Riverwood.",
        "condition_expr": "get_global_value(\"AG_HallLibraryGlobal\") == 1",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_where_library_inns",
        "display_name": "The Guild Library",
        "content": "The Guild Library's skill books are sold at every Guild counter, the inns' as well as the Guild Hall next to Riverwood's.",
        "condition_expr": "get_global_value(\"AG_HallLibraryGlobal\") == 0",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_where_tomes_hall",
        "display_name": "Guild spell tomes",
        "content": "The Guild sells its spell tomes only at the Guild Hall next to Riverwood.",
        "condition_expr": "get_global_value(\"AG_HallTomesGlobal\") == 1",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_where_tomes_inns",
        "display_name": "Guild spell tomes",
        "content": "The Guild sells its spell tomes at every Guild counter, the inns' as well as the Guild Hall next to Riverwood's.",
        "condition_expr": "get_global_value(\"AG_HallTomesGlobal\") == 0",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_where_augments_hall",
        "display_name": "Where Guild Augments are sold",
        "content": "Guild Augments are sold only at the Guild Hall next to Riverwood.",
        "condition_expr": "get_global_value(\"AG_HallAugmentsGlobal\") == 1",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_where_augments_inns",
        "display_name": "Where Guild Augments are sold",
        "content": "Guild Augments are sold at every Guild counter, the inns' as well as the Guild Hall next to Riverwood's.",
        "condition_expr": "get_global_value(\"AG_HallAugmentsGlobal\") == 0",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_where_parties_hall",
        "display_name": "Founding a party",
        "content": "A party is founded, renamed or disbanded only at the Guild Hall next to Riverwood, where the Guild keeps its ledger of parties. Members join and leave a party at any Guild counter.",
        "condition_expr": "get_global_value(\"AG_HallPartiesGlobal\") == 1",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_where_parties_inns",
        "display_name": "Founding a party",
        "content": "A party is founded, renamed, disbanded, joined or left at any Guild counter.",
        "condition_expr": "get_global_value(\"AG_HallPartiesGlobal\") == 0",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "adventurers"
        ]
      },
      {
        "key": "ag_ranks",
        "display_name": "What a Guild rank means",
        "content": "An Adventurers Guild rank is a badge of honour earned by deeds, never bought: Guild jobs finished, dungeons cleared, great beasts slain. E and D are adventurers making their start; C are seasoned hands; B and A are veterans whose names travel from hold to hold; S, for Sealed, marks a living legend whose deeds the Guild's Registrar-General sealed personally. There have never been many, and hardly one is left in Skyrim; an adventurer met on the road is never above A. Only adventurers hold a rank, said as \"a C-rank adventurer\", and higher ranks earn deference.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "ranks"
        ]
      },
      {
        "key": "ag_promotion",
        "display_name": "Merit, Reputation and promotion",
        "content": "Adventurers Guild members earn two things for their work. Merit is spent: on the Guild's services at its counters, and it is what the Guild pays for monster trophies. Reputation is never spent: it is an adventurer's standing, and what a case for promotion is judged on. Guild jobs and dungeons reported at a counter earn both; dangerous kills earn Reputation. Once an adventurer's Reputation and experience are enough, the Guild will hear their case for promotion, for a fee. Past C-rank, a rank means a proven record.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "ranks",
          "merit",
          "reputation",
          "promotion"
        ]
      },
      {
        "key": "ag_missives",
        "display_name": "Guild Missives",
        "content": "Guild Missives are the Adventurers Guild's paid jobs, posted on each hold's missive board: beasts to hunt, bandits to rout, relics to recover, people to find. An adventurer may take missives up to the rank the Guild allows them, as a rule their own, and each one done is reported at a Guild counter for gold and standing. A missive board posts new work every few days, when someone next walks up to it, and right after an adventurer is registered or promoted. A Guild counter lists what is posted on its own town's board and hands those jobs out too.",
        "condition_expr": "is_plugin_loaded(\"Missives.esp\")",
        "always_inject": false,
        "importance": 0.5,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "missives",
          "jobs"
        ]
      },
      {
        "key": "ag_jarl_bounties",
        "display_name": "The Jarls' bounties",
        "content": "A Jarl's bounty is the hold's own business: an innkeeper or the steward hands out the Jarl's letter naming a bandit chief, a Forsworn leader, a giant or a dragon, one bounty to a hold at a time, and the steward pays the gold when it is done. The Adventurers Guild ranks each bounty, lists the hold's bounty at its counter, and credits the adventurer who reports it afterwards.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.5,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "bounty",
          "jarl",
          "jobs"
        ]
      },
      {
        "key": "ag_notices",
        "display_name": "The Guild's notices",
        "content": "Besides the missive boards, the Adventurers Guild posts its notices on the notice boards found across the province, the same notices wherever one stands. An adventurer takes them up to the rank the Guild allows them, as a rule their own, and reports them at a Guild counter like any other Guild work.",
        "condition_expr": "is_plugin_loaded(\"notice board.esp\")",
        "always_inject": false,
        "importance": 0.4,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "notices",
          "jobs"
        ]
      },
      {
        "key": "ag_monster_hunts",
        "display_name": "Monster hunt contracts",
        "content": "Monster hunt contracts go up on the missive boards as well: vampires, werewolves, liches and dragon priests, dragons and stranger beasts. Pepper, a broker at the Drunken Huntsman in Whiterun, pays for each kill; the Adventurers Guild ranks every contract by what is hunted and credits the adventurer who reports it.",
        "condition_expr": "is_plugin_loaded(\"MissivesMonsterHunt.esp\")",
        "always_inject": false,
        "importance": 0.4,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "monsters",
          "hunt",
          "contracts",
          "jobs"
        ]
      },
      {
        "key": "ag_missives_crafting",
        "display_name": "Trade and crafting missives",
        "content": "Not every Guild missive is a fight. The boards also carry the work of a hold's traders and households: a smith wanted to outfit the guards or the army, a full set of armour and a blade made to order, gear to temper or enchant, potions, scrolls and spell books for the alchemists and the court mage, pelts, gemstones, firewood, fish and vegetables for the inns, food for a Jarl's feast, meals and harvests to deliver, books for a noble's library, and rush orders against the clock. There are tombs and mage lairs to clear as well. The Guild ranks them like any other missive and credits whoever reports them; crafters and hunters among its members make a steady living from them.",
        "condition_expr": "is_plugin_loaded(\"MissivesforTheGoodGuys.esp\")",
        "always_inject": false,
        "importance": 0.4,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "missives",
          "crafting",
          "trade",
          "jobs"
        ]
      },
      {
        "key": "ag_missives_outlaws",
        "display_name": "Missives in the Outlaw Refuges",
        "content": "The Outlaw Refuges hidden in the hold capitals keep missive boards of their own, and the work on them is the underworld's: thefts and pickpocketing, smuggling and dead drops, debts collected with a heavy hand, and killings. The Adventurers Guild ranks those jobs like any other missive and credits whoever reports them; nobody at a counter asks where a report came from, and nobody who values their standing talks about it.",
        "condition_expr": "is_plugin_loaded(\"MissivesForTheBadGuys.esp\")",
        "always_inject": false,
        "importance": 0.3,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "missives",
          "outlaws",
          "underworld",
          "jobs"
        ]
      },
      {
        "key": "ag_dwindling",
        "display_name": "Why so few adventurers remain",
        "content": "Skyrim has few adventurers left, and not for want of work: the roads, barrows and caves are as dangerous as ever. The losses came in waves. Many of the Adventurers Guild's registered members died fighting the Aldmeri Dominion in the Great War, when the Legion called them up as auxiliaries. More were lost or set aside in the civil war. And since the Thalmor got hold of the Guild's ledgers, adventurers on its books keep disappearing. Underneath it all, the Guild always had an uphill fight in Skyrim, against the Companions, and its hall stood empty from the Great War until a year ago.",
        "condition_expr": "get_global_value(\"AG_GuildHallInstalledGlobal\") == 1",
        "always_inject": false,
        "importance": 0.9,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "war",
          "history",
          "adventurers"
        ]
      },
      {
        "key": "ag_dwindling_nohall",
        "display_name": "Why so few adventurers remain",
        "content": "Skyrim has few adventurers left, and not for want of work: the roads, barrows and caves are as dangerous as ever. The losses came in waves. Many of the Adventurers Guild's registered members died fighting the Aldmeri Dominion in the Great War, when the Legion called them up as auxiliaries. More were lost or set aside in the civil war. And since the Thalmor got hold of the Guild's ledgers, adventurers on its books keep disappearing. Underneath it all, the Guild always had an uphill fight in Skyrim, against the Companions, and it never had a hall of its own in the province.",
        "condition_expr": "get_global_value(\"AG_GuildHallInstalledGlobal\") == 0",
        "always_inject": false,
        "importance": 0.9,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "war",
          "history",
          "adventurers"
        ]
      },
      {
        "key": "ag_hall_folk",
        "display_name": "Who's who at the Guild Hall",
        "condition_expr": "(is_in_faction(actorUUID, \"AGHall2GuildFaction\") or is_in_faction(actorUUID, \"TownRiverwoodFaction\") or is_in_faction(actorUUID, \"JobInnkeeperFaction\") or is_in_faction(actorUUID, \"AG_AdventurerRankFaction\") or is_in_faction(actorUUID, \"AG_WanderingAdventurerFaction\") or is_in_faction(actorUUID, \"PotentialFollowerFaction\")) and get_global_value(\"AG_GuildHallInstalledGlobal\") == 1",
        "always_inject": false,
        "importance": 0.7,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "hall",
          "riverwood",
          "willem"
        ],
        "content": "The Guild Hall next to Riverwood is run by its Guild Master, Willem, a scarred Nord and retired A-rank who came home from the Great War with the hall's first company and reopened the hall a year ago. Merila Andalen, a Dunmer, is his assistant and keeps the hall's records and library. Two Breton clerks keep the Guild counter: brisk Margot Belleau from early morning and young Nessa from midday into the evening. Cassius Varro, an Imperial who hears every rumour, keeps the tavern's bar. The hall's counter is the one Guild counter in Skyrim that sees every hold's work, where an inn's counter knows only its own hold's. Brynja, a Nord farm girl, serves the tavern, and Old Henriette, who cooked for the first company, runs the kitchen. Four members live in the attic: Ghrulek, a loud Orc warrior of C-rank; Ylva, a quiet B-rank ranger from the Pale; Zhasim, a Khajiit scout who stays D-rank on purpose; and Marius Crassus, the old company's sergeant, a retired A-rank. The best room belongs to Caralion of Cloudrest, a rich young Altmer of C-rank whom nobody likes and whose gold keeps the roof up."
      },
      {
        "key": "ag_guild_board",
        "display_name": "The Guild Board",
        "condition_expr": "get_global_value(\"AG_GuildHallInstalledGlobal\") == 1",
        "always_inject": false,
        "importance": 0.4,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "hall",
          "board",
          "work"
        ],
        "content": "In the great hall of the Guild Hall next to Riverwood hangs the Guild Board, where the Guild posts the work of every hold in Skyrim at once: the missives on the hold capitals' boards, each Jarl's bounty, and the notices passed from town to town. A member reads a posting there and takes it on the spot, as long as it suits their rank. The clerks at the hall's counter keep the same list and will hand out any hold's work across the counter. The inns' counters only know their own hold's. The hall posts each hold's missives itself every few days, and at once when a member is registered or promoted, and a hold's own board adds more when someone stops there to read it; a Jarl's bounty reaches the hall once a steward or innkeeper has put it up, and an adventurer's own bounty, taken and not yet paid, stays on the clerks' list until it is. The hall can also put up a Jarl's bounty itself, for a hold that has none posted: a member who asks for a new bounty is handed the Jarl's letter, and only the letter says which hold, which target and where. The clerks do not know the target before it is read, and the bounty is paid by that hold's Jarl or steward, as any Jarl's bounty is."
      },
      {
        "key": "ag_leader_board",
        "display_name": "The parties' leader board",
        "condition_expr": "get_global_value(\"AG_GuildHallInstalledGlobal\") == 1",
        "always_inject": false,
        "importance": 0.4,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "hall",
          "parties",
          "board",
          "renown"
        ],
        "content": "In Services at the Guild Hall next to Riverwood, on the wall between the two front windows, hangs the parties' leader board: one sheet kept by hand by the clerk Merila Andalen and brought up to date as word comes in. It lists every adventuring party the Adventurers Guild's ledger in Skyrim holds, active and disbanded together, ranked by renown, which is how far a party's name has travelled through its deeds: cleared barrows and missives, great beasts, and days on the road together. Active parties are written with their leader and the year they were founded, disbanded ones with the years they were active and how they ended; the first three are written in red. At the top stand three parties of the hall's first company, the Frostbitten first of all; they disbanded when the company marched to the Great War in 4E 174 and were never formed again. Two newer parties, Stendarr's Mercenaries and the Winterhold Four, broke up over the civil war this year. The Grey Lanterns and Stormbringers are active parties that work far from Riverwood. The Golden Hand is Caralion of Cloudrest's party, founded in 4E 200, and it is climbing the sheet faster than any party in the field. A member's own party is written in as soon as it is founded."
      },
      {
        "key": "ag_rumor_thalmor",
        "display_name": "The disappearances",
        "content": "People whisper that adventurers registered with the Adventurers Guild keep vanishing, and that the Thalmor are behind it.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.5,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "thalmor",
          "rumor"
        ]
      },
      {
        "key": "ag_founding",
        "display_name": "The Guild's founding",
        "content": "The Adventurers Guild was chartered in the Imperial City in 4E 17 by Emperor Titus Mede I, the first of the Mede emperors. Its heart is the Wayfarers' Hall in the Market District, where the Registrar-General seals the names of legends.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.4,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "history",
          "cyrodiil"
        ]
      },
      {
        "key": "ag_history",
        "display_name": "History of the Adventurers Guild",
        "content": "Emperor Titus Mede I chartered the Adventurers Guild in 4E 17, the year he took the Ruby Throne and ended the Stormcrown Interregnum, to turn the Empire's masterless swords to good use: hunting the monsters and bandits the Legion could not reach, and standing ready when the Empire called. It took up the freelance work of the old Fighters Guild, but opened its doors to anyone with courage, man or mer, and let them rise by their deeds alone. From the Wayfarers' Hall in the Imperial City its Registrar-General ranks adventurers and seals the names of legends. In the Great War the Legion called up the Guild's adventurers as auxiliaries, and many died heroes at the Imperial City and the Red Ring; Skyrim sent more than its share.",
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\") or is_in_faction(actorUUID, \"BardSingerFaction\") or is_in_faction(actorUUID, \"JobJarlFaction\") or is_in_faction(actorUUID, \"JobStewardFaction\")",
        "always_inject": false,
        "importance": 0.7,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "history",
          "cyrodiil",
          "great war"
        ]
      },
      {
        "key": "ag_compromise",
        "display_name": "Skyrim's Guild Hall",
        "content": "Each province has one central hall of the Adventurers Guild. When the Guild came to Skyrim in 4E 168, under a charter from Titus Mede II in the year of his crowning, the Jarls would grant no land inside their capitals to an Imperial-chartered guild, and the Companions claimed the cities' glory. High King Istlod settled it: one hall, outside the hold capitals, on the road next to Riverwood, and a counter in the inn of each hold capital, where the innkeepers serve as the Guild's reps. The hall's first company marched to the Great War as Legion auxiliaries and few came home; the hall stood shut for twenty-five years while the counters kept the Guild alive. Willem, a retired A-rank and one of the six who came back, reopened it in 4E 200.",
        "condition_expr": "(is_in_faction(actorUUID, \"CollegeofWinterholdFaction\") or is_in_faction(actorUUID, \"BardSingerFaction\") or is_in_faction(actorUUID, \"JobJarlFaction\") or is_in_faction(actorUUID, \"JobStewardFaction\") or is_in_faction(actorUUID, \"JobInnkeeperFaction\") or is_in_faction(actorUUID, \"CompanionsFaction\")) and get_global_value(\"AG_GuildHallInstalledGlobal\") == 1",
        "always_inject": false,
        "importance": 0.7,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "history",
          "jarls",
          "hall"
        ]
      },
      {
        "key": "ag_compromise_nohall",
        "display_name": "Skyrim's Guild Hall",
        "content": "Each province has a central hall of the Adventurers Guild, save Skyrim. When the Guild came to Skyrim in 4E 168, under a charter from Titus Mede II in the year of his crowning, the Jarls would grant no land to an Imperial-chartered guild, and the Companions claimed the cities' glory. High King Istlod settled it: no hall in Skyrim, and a counter in the inn of each hold capital, where the innkeepers serve as the Guild's reps.",
        "condition_expr": "(is_in_faction(actorUUID, \"CollegeofWinterholdFaction\") or is_in_faction(actorUUID, \"BardSingerFaction\") or is_in_faction(actorUUID, \"JobJarlFaction\") or is_in_faction(actorUUID, \"JobStewardFaction\") or is_in_faction(actorUUID, \"JobInnkeeperFaction\") or is_in_faction(actorUUID, \"CompanionsFaction\")) and get_global_value(\"AG_GuildHallInstalledGlobal\") == 0",
        "always_inject": false,
        "importance": 0.7,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "history",
          "jarls",
          "hall"
        ]
      },
      {
        "key": "ag_ledgers",
        "display_name": "What the Thalmor did with the Guild's registers",
        "content": "Every adventurer's name and deeds go by courier to the Wayfarers' Hall in the Imperial City. Under the White-Gold Concordat the Thalmor demanded copies of the Guild's registers, to find Talos worshippers among the armed population; the Registrar-General protested and was overruled, and the Justiciars still get updates. Since then adventurers on the books have been vanishing, often veterans who fought the Dominion. Nobody can prove the Thalmor are behind it, but most in the Guild believe it. The Guild cannot openly defy them, so it looks after its own quietly: the reps write down less than they used to, some adventurers sign on under road names, and an innkeeper will warn a newcomer, over a drink, what not to say where a Justiciar can hear. The Guild's official line is that it has no quarrel with the Aldmeri Dominion.",
        "condition_expr": "is_in_faction(actorUUID, \"JobInnkeeperFaction\")",
        "always_inject": false,
        "importance": 0.8,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "thalmor",
          "ledgers",
          "secret"
        ]
      },
      {
        "key": "ag_companions",
        "display_name": "The Companions and the Adventurers Guild",
        "content": "The Adventurers Guild is the Companions' friendly rival for work and glory in Skyrim. Two proud traditions: the Companions have Jorrvaskr, the honour of Ysgramor's line and a Circle that chooses its own; the Guild takes anyone with courage and lets them rise by their deeds. There is real respect between them, and many a Companion has shared a drink and a hunt with Guild adventurers, but the Companions still hold themselves the finer warriors, and say so.",
        "condition_expr": "is_in_faction(actorUUID, \"CompanionsFaction\")",
        "always_inject": false,
        "importance": 0.8,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "companions"
        ]
      },
      {
        "key": "ag_oath",
        "display_name": "The Guild's Neutrality Oath",
        "content": "The Adventurers Guild swears its members to a Neutrality Oath in the civil war: it posts no war contracts, and a member who takes up Legion or Stormcloak colours, or a guard's post, is recorded as set aside. That is why so many guards and soldiers are retired adventurers who still carry an old rank. Since 4E 201 the Guild's membership in Skyrim has halved.",
        "condition_expr": "is_in_faction(actorUUID, \"GuardDialogueFaction\") or is_in_faction(actorUUID, \"CWImperialFaction\") or is_in_faction(actorUUID, \"CWSonsFaction\")",
        "always_inject": false,
        "importance": 0.7,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "civil war",
          "oath"
        ]
      },
      {
        "key": "ag_stormcloak",
        "display_name": "A Stormcloak's view of the Guild",
        "content": "To a Stormcloak the Adventurers Guild is an Imperial instrument: its charter in Skyrim comes from the Emperor who signed the White-Gold Concordat, and its registers ended up in Thalmor hands, which only proves the Empire sells Nords to the elves. Ulfric tolerates the Guild's counter at Candlehearth Hall because trolls care nothing for politics.",
        "condition_expr": "is_in_faction(actorUUID, \"CWSonsFaction\")",
        "always_inject": false,
        "importance": 0.8,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "stormcloaks",
          "empire"
        ]
      },
      {
        "key": "ag_imperial",
        "display_name": "The Legion's view of the Guild",
        "content": "The Legion remembers that the Adventurers Guild's registered adventurers fought beside it as auxiliaries in the Great War, and many died at the Imperial City and the Red Ring. Officers respect the Guild but resent its Neutrality Oath now that the Legion needs every sword against the Stormcloaks.",
        "condition_expr": "is_in_faction(actorUUID, \"CWImperialFaction\")",
        "always_inject": false,
        "importance": 0.7,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "legion",
          "great war"
        ]
      },
      {
        "key": "ag_thalmor",
        "display_name": "What the Thalmor know of the Guild",
        "content": "Under the White-Gold Concordat the Thalmor hold copies of the Adventurers Guild's registers, a convenient list of armed Nords and veterans who once fought the Dominion. The Guild's quiet suspicion of the Thalmor is well known to you, and faintly amusing: it can do nothing about it.",
        "condition_expr": "is_in_faction(actorUUID, \"ThalmorFaction\")",
        "always_inject": false,
        "importance": 0.8,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "thalmor",
          "ledgers"
        ]
      },
      {
        "key": "ag_solstheim",
        "display_name": "The Guild on Solstheim",
        "content": "For years the Adventurers Guild had no counter on Solstheim: House Redoran let its members work on the island and nothing more. That changed when the ash spawn began coming over the Bulwark. Councilor Morvayn licensed a counter at the Retching Netch in Raven Rock, and Geldis Sadri keeps it at the end of his bar. Work on the island comes mostly by word of mouth, through Geldis. The Redoran Guard still care more for results than for rank letters, and the Skaal judge a warrior by deeds, not by any mainland rank.",
        "condition_expr": "is_in_faction(actorUUID, \"DLC2RavenRockGuardFaction\") or is_in_faction(actorUUID, \"DLC2SkaalVillageCitizenFaction\")",
        "always_inject": false,
        "importance": 0.7,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "solstheim"
        ]
      },
      {
        "key": "ag_parties",
        "display_name": "Adventuring parties",
        "content": "Adventurers of the Adventurers Guild often band together as a party, registered with the Adventurers Guild under a name of their own choosing. The Adventurers Guild writes each party into its ledger: who marched with it, who left, and who fell. A party shares its road, its dangers and its glory, and a good party name is worn with pride, shouted in a tavern toast and painted on a shield.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.6,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "party",
          "parties",
          "adventurers"
        ]
      },
      {
        "key": "ag_party_bond",
        "display_name": "A party's bond",
        "content": "Adventurers speak of a party's bond: how well its members fight as one. A new party are Strangers; with shared fights they become Companions, then Comrades; the tried and true are Sworn; and a very few become Legend. Bond cannot be bought or ordered. It is earned only on the road together, fights shared, barrows cleared and missives done side by side, and a party with a deep bond fights with a strength no lone adventurer has.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.4,
        "type": "KNOWLEDGE",
        "tags": [
          "party",
          "bond",
          "adventurers"
        ]
      },
      {
        "key": "ag_party_fame",
        "display_name": "Famous parties",
        "content": "In the inns, folk trade tales of adventuring parties the way they trade tales of heroes. A party's name starts to travel once it has cleared enough barrows and hunted enough great beasts, and the most famous are recognised on sight in every hold, their deeds sung by bards.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.4,
        "type": "KNOWLEDGE",
        "tags": [
          "party",
          "fame",
          "taverns"
        ]
      },
      {
        "key": "ag_appraisal",
        "display_name": "Appraisal",
        "content": "Adventurers Guild members learn Appraisal: the skill of sizing up what stands in front of them and analyzing the threat it poses, measured as a rank. The Guild teaches it, for Merit, in three levels. The first reads fellow adventurers, ordinary folk, the beasts of the wild and how dangerous a barrow or cave is. The second reads the things of legend: trolls, draugr, vampires, dragons, Dwemer machines. The third is rare, and it alone can measure the deadliest threats, those of rank A and S; to anyone less practised such a foe is simply beyond measure, which is warning enough. No one states the rank of a foe they could not read.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.5,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "appraisal",
          "ranks",
          "threat"
        ]
      },
      {
        "key": "ag_guild_card",
        "display_name": "The guild card",
        "content": "Every registered adventurer carries a guild card: their name, their rank, the day they registered, and the crest stamps of the holds they have served. The Guild's rep updates it at each promotion, and a lost card is replaced at any Guild counter for a small fee. A card is its holder's own: someone else's card handed in at a counter goes back to its owner, and the card of a dead adventurer lets the Guild close their page and write to their kin.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.5,
        "type": "KNOWLEDGE",
        "tags": [
          "guild card",
          "adventurers",
          "guild"
        ]
      },
      {
        "key": "ag_augments",
        "display_name": "Guild Augments and tomes",
        "content": "The Adventurers Guild sells Guild Augments for Merit: a preparation taken before a job that lasts one day. There are five: Packhorse for carrying more, Haggler for better prices, Quick Study for learning faster, Hardy against disease and poison, and Vigor for more health, stamina and magicka. An adventurer may hold one at a time. The Guild also sells spell tomes. A member may buy tomes of their own rank, and of one rank above at twice the Merit; anything higher is not offered.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.5,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "augments",
          "tomes",
          "merit"
        ]
      },
      {
        "key": "ag_training",
        "display_name": "Guild Training",
        "content": "The Adventurers Guild sells training for Merit. The Guild's drills make a member hardier: more health, stamina or magicka for good, though each stat's training is capped by the rank they have reached, and each lesson costs more than the last. From D-rank up, a member may also buy perk training: a veteran's lesson in a technique, worth what a hard-won step in experience would teach them. One lesson for each rank from D to S, five in all, and it is never cheap: 100 Merit for the first, up to 500 for the last. Rank is earned by Reputation, so only a member with real standing gets the most of it.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.5,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "training",
          "perks",
          "merit"
        ]
      },
      {
        "key": "ag_wares",
        "display_name": "Guild Boxes",
        "content": "The Adventurers Guild sells Guild Boxes from its vaults: a strongbox opened on the spot, with a weapon, a piece of armour or a jewel inside, enchanted for whoever buys it, paid for in Merit, gold and Reputation. A Guild Box holds a modest enchantment and is sold from D-rank; a Blessed Box a strong one, from C-rank; a Cursed Box, a sealed tomb chest sold from B-rank, an enchantment stronger than any found in the wild, and a curse that comes with it: slower healing, or a weakness to fire, frost, shock or magic, for as long as it is worn or held. The Guild sells them but frowns on them: a member who buys their power is taking a gambler's shortcut, and it costs them standing. Old hands tease anyone who shows off a cursed blade.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.5,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "boxes",
          "cursed",
          "merit",
          "reputation"
        ]
      },
      {
        "key": "ag_intel",
        "display_name": "What the Guild's scouts know",
        "content": "The Adventurers Guild keeps scouts, and sells what they know at its counters for Merit. Mostly that is where a hold's dungeons lie and how dangerous each one is. But the scouts also mark places that are no dungeon at all and still worth an adventurer's while: an Orc stronghold, a standing stone, a Daedric shrine, a hunters' shack, a lodge of the Vigilants of Stendarr, a landmark, a wreck on the shore. An innkeeper who keeps a counter will put any of that hold's on an adventurer's map; the clerks at the Guild Hall know every hold's.",
        "condition_expr": "get_global_value(\"AG_GuildHallInstalledGlobal\") == 1",
        "always_inject": false,
        "importance": 0.5,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "intel",
          "scouts",
          "map"
        ]
      },
      {
        "key": "ag_intel_nohall",
        "display_name": "What the Guild's scouts know",
        "content": "The Adventurers Guild keeps scouts, and sells what they know at its counters for Merit. Mostly that is where a hold's dungeons lie and how dangerous each one is. But the scouts also mark places that are no dungeon at all and still worth an adventurer's while: an Orc stronghold, a standing stone, a Daedric shrine, a hunters' shack, a lodge of the Vigilants of Stendarr, a landmark, a wreck on the shore. An innkeeper who keeps a counter will put any of that hold's on an adventurer's map.",
        "condition_expr": "get_global_value(\"AG_GuildHallInstalledGlobal\") == 0",
        "always_inject": false,
        "importance": 0.5,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "intel",
          "scouts",
          "map"
        ]
      },
      {
        "key": "ag_wanderers",
        "display_name": "Adventurers on the roads",
        "content": "Not every adventurer is found at an inn. Members of the Adventurers Guild walk the roads between jobs, a missive in the pack and a guild card at the belt, and most are glad of a word with another adventurer: which board has work, which pass has trolls, who made rank. Folk can usually tell one by the mismatched armor and the easy way with a weapon. They're separate from the sellswords and mercenaries, but share the same roads, and some are known to take up both professions.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.5,
        "type": "KNOWLEDGE",
        "tags": [
          "adventurers",
          "roads",
          "travel"
        ]
      },
      {
        "key": "ag_card_shown",
        "display_name": "Showing a guild card",
        "content": "A guild card is more than a keepsake: it is proof that the Adventurers Guild vouches for its bearer, and some doors open to it. At the College of Winterhold, Faralda accepts the card in place of her test of magic. At the Treasury House in Markarth, the Silver-Bloods hold the lease on the Guild counter, so a member of C-rank or above is shown in as family business. The Orc strongholds, which turn outlanders away, respect proven strength: an adventurer of A-rank or above is welcomed at the gate as a friend of the stronghold. City gates open to it as well: the guard at Whiterun's gate lets a member through with an apology when the city is closed to strangers, and the guard at Riften's north gate drops his talk of a visitor's tax. On the roads, a robber who learns he has stopped an adventurer of B-rank backs off, and one who has stopped an A-rank or S-rank begs for his life.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.5,
        "type": "KNOWLEDGE",
        "tags": [
          "adventurers",
          "guild card",
          "college",
          "markarth",
          "orcs"
        ]
      },
      {
        "key": "ag_hold_stamps",
        "display_name": "Hold stamps on a guild card",
        "content": "A well-travelled guild card carries more than the wax seal of the region that issued it. When a member has cleared enough dungeons in a hold and reported them to the Guild (at any counter), the Guild counter in that hold's capital inks the hold's own crest onto the card: Whiterun's horse, Solitude's wolf, Windhelm's bear, Riften's crossed daggers, Markarth's ram, Falkreath's stag, Morthal's triskelion, Dawnstar's star, Winterhold's crown, and House Redoran's scarab at Raven Rock. Each counter stamps only for its own hold, so the stamps on a card show where an adventurer has done real work, and in what order. A replacement card comes blank and must be stamped again, counter by counter. Where a hold's counter has closed because its keeper died, whoever took over the inn still has the stamp and will use it for an adventurer who has earned it. Merchants in a hold give a better price to an adventurer whose card carries that hold's stamp.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.5,
        "type": "KNOWLEDGE",
        "tags": [
          "adventurers",
          "guild card",
          "holds",
          "dungeons"
        ]
      },
      {
        "key": "ag_conduct",
        "display_name": "An adventurer's good name",
        "content": "The Adventurers Guild does not much care what its members get up to outside its work, until they are caught at it. The Guild works in each hold by the leave of its Jarl and will not have that put at risk, so a price on an adventurer's head in a hold reaches the Guild's ledger: it costs the adventurer Reputation, and the Guild will hear no case for promotion while it stands. Paying the fine or serving the time settles it, and any Guild counter will pay off every hold's bounty at once for a small fee. An adventurer who takes a Guild job and walks away from it loses standing too. The Guild never strips a rank once earned.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.5,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "reputation",
          "crime",
          "bounty"
        ]
      },
      {
        "key": "ag_counter_lost",
        "display_name": "When a counter closes",
        "content": "The innkeeper who keeps a hold's counter is a representative of the Adventurers Guild, approved by the Guild to conduct its business on its behalf. When one dies, whoever takes over the inn is sometimes approved to keep the counter on, and sometimes a town is left without a representative, and its adventurers must carry their reports and trophies to another hold capital.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.3,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "counter",
          "innkeeper"
        ]
      },
      {
        "key": "ag_liaison_duties",
        "display_name": "Keeping a Guild counter",
        "content": "As the Adventurers Guild's licensed liaison at this inn's counter: buys monster trophies for Merit, pays out adventurers' reports (gold, Merit and Reputation), hands out the hold's Guild work, sells the Guild's intel on dungeons and on other places worth knowing, replaces lost guild cards, and does whatever else of the Guild's business the Guild leaves to its inns. The innkeepers who keep a Guild counter are its proud reps: warm, practical hosts who have seen many adventurers come and go. Knows why the Guild's ranks have grown so thin in Skyrim, and speaks of the disappearances carefully, never where a Thalmor might hear.",
        "condition_expr": "get_faction_rank(actorUUID, \"AG_GuildLiaisonFaction\") >= 0",
        "always_inject": false,
        "importance": 0.8,
        "type": "KNOWLEDGE",
        "tags": [
          "guild",
          "counter",
          "innkeeper",
          "liaison"
        ]
      },
      {
        "key": "ag_party_fallen",
        "display_name": "Remembering the fallen",
        "content": "When a party member falls, the Adventurers Guild keeps their name in its ledger with the place they fell. Adventurers raise a cup to them at the counter, and a party carries its fallen in its stories.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.3,
        "type": "KNOWLEDGE",
        "tags": [
          "party",
          "fallen",
          "memorial"
        ]
      },
      {
        "key": "ag_dungeon_dead",
        "display_name": "Adventurers who never came back",
        "content": "The barrows, caves and ruins of Skyrim hold the bodies of adventurers who went in and never came out. Most were members of the Adventurers Guild, and a dead adventurer's guild card is usually still on them, stained with their blood. Whoever brings such a card to an Adventurers Guild counter lets the Guild close that page of its ledger and write to their kin, and the Guild remembers who did it.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.4,
        "type": "KNOWLEDGE",
        "tags": [
          "adventurers",
          "dungeons",
          "fallen",
          "guild card"
        ]
      },
      {
        "key": "ag_party_coincidence",
        "display_name": "Obviously a coincidence",
        "content": "Adventurers Guild folk have a running joke about the adventurer who travels with four or more companions, every one of them of the other sex. 'Obviously a coincidence,' they say, with a look. Counter talk teases such a party gently; few say it to the adventurer's face unless they are drunk or brave.",
        "condition_expr": "",
        "always_inject": false,
        "importance": 0.3,
        "type": "KNOWLEDGE",
        "tags": [
          "party",
          "parties",
          "adventurers",
          "gossip"
        ]
      }
    ]
  }
}
