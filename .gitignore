# this machine's paths
local.env

# build output
build/
src/plugin/build/
tools/EspGen/bin/
tools/EspGen/obj/
tools/HallGen/**/bin/
tools/HallGen/**/obj/
tools/HallGen/bin/
tools/HallGen/obj/
tools/HallGen/npcs/build/
__pycache__/
release/

# large or derived local data
snapshots/
tools/voice_cache/
config/Sound/

# private working files: only the generators under tools/ are published (the hall's private files: tools/hall-private)
BACKLOG.md
/tools/*
!/tools/EspGen/
!/tools/HallGen/

# check-public.sh (the pre-push hook) refuses a push if any of the above is tracked anyway.

# screenshots are kept out of the repository (they go on the mod page)
docs/images/
docs/SCREENSHOTS.md
config/PrismaUI/views/AdventurersGuild/tex/skin/
config/PrismaUI/views/AdventurersGuild/tex/chest/
# the guild card's textures are made from the game's parchment (tools/make_card_item.py); the meshes are ours and are kept
config/textures/
# ... and what the inventory shows is the game's own menu note with the card laid in it: the game's mesh data, not published
config/meshes/AdventurersGuild/*_inv.nif

# Claude Code settings: settings.local.json keeps approved commands verbatim, secrets included. Never commit.
.claude/
